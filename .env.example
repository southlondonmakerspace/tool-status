# Copy to .env and fill in. Never commit .env.

# Public hostname. Caddy gets an HTTPS certificate for it, so its DNS must
# point at this server and ports 80 and 443 must be open.
SITE_DOMAIN=woodshop.porridge.cc

# Name shown in the header and page titles. Defaults to "Tool Status".
SITE_NAME=Woodshop

# Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=change-me

DEBUG=false

# The space's local time zone, used for "maintained today". Defaults to Europe/London.
TIME_ZONE=Europe/London
DJANGO_ALLOWED_HOSTS=woodshop.porridge.cc,127.0.0.1,localhost
CSRF_TRUSTED_ORIGINS=https://woodshop.porridge.cc

# Set to false only if the site is served over plain HTTP.
SECURE_COOKIES=true

# Single sign-on with OpenID Connect (e.g. Authentik). Leave OIDC_CLIENT_ID
# empty to turn it off. Redirect URI to register with the provider:
#   https://<your domain>/accounts/oidc/sso/login/callback/
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# The provider's issuer URL; /.well-known/openid-configuration is added to it.
OIDC_SERVER_URL=https://auth.example.org/application/o/tool-status/
# Label on the sign-in button. Defaults to "SSO".
OIDC_PROVIDER_NAME=Authentik
# Claim holding the user's group names. Defaults to "groups".
OIDC_GROUPS_CLAIM=groups
# Members of this group become superusers. Leave empty for none.
OIDC_SUPERUSER_GROUP=Systems
