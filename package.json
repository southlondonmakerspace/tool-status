{
  "name": "tool-status-css",
  "private": true,
  "description": "Builds the site's Bootstrap CSS from static/scss. Docker runs this for you.",
  "scripts": {
    "build:css": "sass --load-path=node_modules --style=compressed --no-source-map --quiet-deps --silence-deprecation=import static/scss/bootstrap.scss static/vendor/bootstrap/bootstrap.min.css",
    "watch:css": "sass --watch --load-path=node_modules --style=compressed --no-source-map --quiet-deps --silence-deprecation=import static/scss/bootstrap.scss static/vendor/bootstrap/bootstrap.min.css"
  },
  "devDependencies": {
    "bootstrap": "5.3.9",
    "sass": "1.107.1"
  }
}
