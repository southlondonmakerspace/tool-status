# Copy to .env and fill in. Never commit .env.

# Public hostname. Caddy gets an HTTPS certificate for it, so its DNS must
# point at this server and ports 80 and 443 must be open.
SITE_DOMAIN=woodshop.porridge.cc

# Name shown in the header and page titles. Defaults to "Tool Status".
SITE_NAME=Woodshop

# Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=change-me

DEBUG=false
DJANGO_ALLOWED_HOSTS=woodshop.porridge.cc,127.0.0.1,localhost
CSRF_TRUSTED_ORIGINS=https://woodshop.porridge.cc

# Set to false only if the site is served over plain HTTP.
SECURE_COOKIES=true
